{
  "name": "virtual-character-studio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.cjs",
    "sync:libraries": "node scripts/sync-libraries.mjs",
    "start": "node scripts/build.mjs && python3 studio_server.py",
    "start:static": "node scripts/build.mjs && python3 -m http.server 4174 --directory dist",
    "test:server": "python3 -m unittest discover -s tests -p \"test_*.py\""
  }
}
