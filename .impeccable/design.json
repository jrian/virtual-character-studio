  "narrative": {
    "northStar": "角色工作台",
    "overview": "浅鼠尾草色底面托住白色编辑区与阅读面，森林绿标示行动与选择。紧凑的中文控件服务于条件编辑，较舒展的人物档案服务于连续阅读；内容层级依靠字号、留白和细分隔线形成。\n\n这是对实际实现的记录，视觉命名为文档描述，并不代表用户另行批准了品牌方向。方向选择页等待超时，当前方向按可逆假设落地；没有已批准的设计稿或 QUALITY BAR 卡。未来大幅改变视觉身份时需重新确认方向。本界面保持本地规则生成的事实边界；外部服装资源以元数据和可选选择器呈现，不把元数据表现成已生成的图片或推断结果。",
    "keyCharacteristics": [
      "浅灰绿底面、森林绿操作、白色阅读面。",
      "专用中文展示字配系统正文与原生表单。",
      "选择、生成快照与待更新状态均有文字线索。",
      "平面容器、细边线、有限的圆角层级。"
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "已选状态与待更新状态需要文字或勾选线索，不能只改变底色。",
        "section": "colors"
      },
      {
        "name": "The Two Reading Speeds Rule",
        "body": "编辑控件保持紧凑；人物段落保留更宽的行距，不把长篇档案压成标签密度。",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "常驻编辑和阅读容器保持平面，浮层阴影留给临时反馈。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 使用森林绿强调行动与当前状态，以白纸承载编辑和长文。",
      "**Do** 为选择、快照和待更新状态提供明确文字线索。",
      "**Do** 保持移动端先编辑后阅读的顺序，展开来源选择器时允许自然纵向增长。",
      "**Do** 保存自托管展示字体的出处与 OFL 许可，并允许子集之外的中文字符回退。",
      "**Do** 保留本地规则生成与元数据来源的准确说明。"
    ],
    "donts": [
      "**Don't** 将静态面板改为悬浮阴影卡，或把只读快照包装成交互按钮。",
      "**Don't** 将展示字体扩展为所有表单与长文的默认字体。",
      "**Don't** 把外链图片、服装标签或分类属性表现为本站已生成的角色图片。"
    ]
  }
}
